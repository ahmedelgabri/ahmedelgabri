{
  "exports": "./mod.ts",
  "version": "8.1.0",
  "name": "@ahmed/card",
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41.3",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.10.3",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/semver": "jsr:@std/semver@^1.0.0",
    "boxen": "npm:boxen@^8.0.1",
    "esbuild": "npm:esbuild@^0.27.2"
  },
  "tasks": {
    "dev": "deno run --allow-env --watch mod.ts",
    "test": "deno test --allow-env",
    "build": "deno run -A scripts/build.ts",
    "publish": "deno run -A scripts/publish.ts",
    "gzip": "deno run -A scripts/gzip.ts",
    "publish:npm": "cd npm && npm publish"
  },
  "exclude": [
    "npm",
    ".direnv",
    ".envrc",
    "shell.nix"
  ]
}
