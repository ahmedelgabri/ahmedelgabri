{
	"exports": {
		".": "./cli.ts",
		"./cli": "./cli.ts",
		"./mod": "./mod.ts"
	},
	"version": "9.0.0",
	"name": "@ahmed/card",
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.0",
		"@std/fmt": "jsr:@std/fmt@^1.0.0",
		"@std/semver": "jsr:@std/semver@^1.0.0",
		"esbuild": "npm:esbuild@^0.27.2"
	},
	"tasks": {
		"dev": "deno run --allow-env --watch cli.ts",
		"test": "deno test --allow-read --allow-run",
		"test:artifact": "deno task build && deno run --allow-read --allow-run scripts/test_artifact.ts",
		"test:workerd": "deno task build && deno run --allow-run scripts/test_workerd.ts",
		"build": "deno run -A scripts/build.ts",
		"check:package": "deno run --allow-read scripts/check_artifact.ts && deno run -A npm:publint@0.3.23 npm && deno run -A npm:@arethetypeswrong/cli@0.18.5 --pack npm --profile esm-only",
		"publish": "deno run -A scripts/publish.ts",
		"gzip": "deno run -A scripts/gzip.ts",
		"publish:npm": "cd npm && npm publish",
		"format": "deno fmt"
	},
	"exclude": [
		"npm",
		".direnv",
		".envrc"
	],
	"publish": {
		"include": ["LICENSE", "README.md", "cli.ts", "deno.jsonc", "mod.ts"]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"indentWidth": 2,
		"semiColons": false,
		"singleQuote": true,
		"proseWrap": "never",
		"include": ["./"]
	}
}
